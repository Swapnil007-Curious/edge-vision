# Python
__pycache__/
*.py[cod]
*.egg-info/
build/
dist/
.pytest_cache/

# Virtual environments
.venv/
venv/

# Data and generated outputs
# Anchored to the repo root: a bare "data/" would also ignore src/edgevision/data/.
/data/
results/**/artifacts
# Quantised models; their quant_report.json files and the result CSVs stay tracked.
results/quant/**/*.onnx
results_bundle.zip
*.pt
*.onnx
*.npz
*.parquet

# Tool caches
.ipynb_checkpoints/
.mypy_cache/
.ruff_cache/

# Web demo: dependencies, fetched third-party assets (npm run fetch-assets) and test output.
web/node_modules/
web/dist/
web/public/mediapipe/
web/test-results/
web/playwright-report/
# The exported browser model is committed while it stays under 10 MB.
!web/public/model/model.onnx
